#pragma once

#cmakedefine XAD_SHARED_LIBS

// XAD_API: exported; XAD_VISIBLE: unique across modules (exceptions);
// XAD_TEMPLATE_API/_EXPORT: extern template declarations/definitions
#if defined(XAD_SHARED_LIBS)
#if defined(_WIN32) || defined(__CYGWIN__)
#ifdef xad_EXPORTS
#define XAD_API __declspec(dllexport)
#else
#define XAD_API __declspec(dllimport)
#endif
#if defined(_MSC_VER) && defined(xad_EXPORTS)
#define XAD_TEMPLATE_API
#define XAD_TEMPLATE_EXPORT XAD_API
#else
#define XAD_TEMPLATE_API XAD_API
#define XAD_TEMPLATE_EXPORT
#endif
#define XAD_VISIBLE
#else
#define XAD_API __attribute__((visibility("default")))
#define XAD_TEMPLATE_API XAD_API
#define XAD_TEMPLATE_EXPORT
#define XAD_VISIBLE XAD_API
#endif
#else
#define XAD_API
#define XAD_TEMPLATE_API
#define XAD_TEMPLATE_EXPORT
#define XAD_VISIBLE
#endif
